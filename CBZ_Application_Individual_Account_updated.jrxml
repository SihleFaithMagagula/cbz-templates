		<band height="811">
			<staticText>
				<reportElement x="0" y="14" width="555" height="14" forecolor="#1B3A5C" uuid="23c9b763-b51f-42b1-881f-404602ac738b"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[TERMS AND CONDITIONS]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="29" width="270" height="12" forecolor="#1B3A5C" uuid="7de6fef8-596d-43d8-87aa-bacd81394fa7">
					<property name="local_mesure_unitheight" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[1.INTRODUCTION]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="59" width="272" height="47" forecolor="#333333" uuid="026c01fd-4011-42ed-8fae-d28733778f76"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[4.4.The Client retains the right to access, correct, restrict processing, delete their data, withdraw consent, and object to marketing. These rights may be exercised by contacting the Bank's Data Protection Officer at privacy@cbz.co.zw.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="502" width="270" height="44" forecolor="#333333" uuid="e948f99f-8257-4415-b49f-f7b954dc5a78"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[The Bank may use my contact information to send relevant product information or updates, in compliance with consent and opt out rules. I may withdraw my consent to marketing at any time through the channels provided by the Bank.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="324" width="270" height="12" forecolor="#1B3A5C" uuid="ef979991-9601-4422-830e-f5ccc1459ce0">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[3. ELECTRONIC & DIGITAL BANKING]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="390" width="270" height="27" forecolor="#333333" uuid="7767190c-d15f-451b-b215-6c7d83f5592c">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[I consent to the use of electronic signatures, which are legally binding.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="658" width="270" height="12" forecolor="#1B3A5C" uuid="2cc3218d-9095-4b4a-a998-01138bef10a0">
					<property name="local_mesure_unitheight" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[4.DATA PROTECTION & PRIVACY]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="46" width="270" height="40" forecolor="#333333" uuid="794680b1-0c87-47ce-ad13-53ca19cc14a2"/>
				<textElement>
					<font fontName="Arial" size="6.5"/>
				</textElement>
				<text><![CDATA[These Terms and Conditions govern the relationship between CBZ Bank Limited ("the Bank") and the individual account holder ("I", "me", "my"). By opening and operating an account with the Bank, I agree to these Terms as amended from time to time.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="548" width="270" height="12" forecolor="#1B3A5C" uuid="1161e586-071f-4559-832a-bbb1b8ae9b49">
					<property name="local_mesure_unitheight" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[3.2. Breach Notification]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="351" width="270" height="26" forecolor="#333333" uuid="840e8040-9ccc-4040-b49f-564c48fa2c09"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[I must keep passwords, PINs and credentials secure. The Bank may rely on electronically authenticated instructions.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="514" width="272" height="91" forecolor="#333333" uuid="9a8ccd9d-3810-4601-97ea-549f3cfe85ac"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[5.3.1. The account may be subject to operational limits such as:
a.maximum daily withdrawal amounts;
b.transfer value restrictions;
c.ATM and card transaction limits;
d.mobile banking or online transaction caps; and
e.limits based on account tier or risk classification.
5.3.2. These limits may be adjusted by the Bank for security, regulatory, or operational reasons.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="244" width="272" height="12" forecolor="#1B3A5C" uuid="b2a2cff7-53a2-4ca1-84b3-e4f355f1ddd4">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[5. ACCOUNT LIMITATIONS, DORMANCY & CLOSURE]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="262" width="270" height="12" forecolor="#1B3A5C" uuid="e36f48be-b6d4-4720-a1ea-b6665984b926">
					<property name="local_mesure_unitheight" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[2.4. Notices & Communication]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="338" width="270" height="12" forecolor="#1B3A5C" uuid="dc944e9a-8afc-4892-9a87-ff0878fef065">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[3.1. Access & Security]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="425" width="270" height="27" forecolor="#333333" uuid="12bd5b63-ccbd-468a-aef5-427551692f74">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[Electronic records are treated as original documents if storable and reproducible.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="171" width="270" height="32" forecolor="#333333" uuid="3e2c5a01-fa7f-47aa-894a-813fb94712d6"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[a.Transactions are processed electronically through authorised channels including mobile banking, online banking, cards, POS and ATM.
b.All instructions must be issued through approved digital channels using the Bank's security procedures.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="287" width="272" height="124" forecolor="#333333" uuid="06337821-4c79-4711-b39c-157d8690dd0d"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[5.1.1. The Bank may restrict or decline transactions where required to comply with:
a.anti money laundering and counter terrorist financing laws;
b. sanctions regulations;
c. court orders or legal directives;
d. tax authority requests; and
e. fraud prevention protocols.
5.1.2. The Bank may block, delay, freeze, or reverse a transaction if it believes such action is necessary to comply with applicable law or protect the account.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="413" width="270" height="12" forecolor="#1B3A5C" uuid="2f61eeed-3465-49b1-88a9-a638e73320e7">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[3.3. Digital Statements & Records]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="411" width="272" height="85" forecolor="#333333" uuid="a9e18756-d866-4239-a97c-0295e535b88a"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[5.2.1.The Bank may temporarily restrict account access or digital banking services if:
a.suspicious or unusual transactions are detected;
b. access credentials appear compromised;
c. there are repeated failed login attempts; or
d. a device used to access the account is reported lost or stolen
5.2.2. Restrictions remain until the Bank completes verification and confirms that the account is secure.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="158" width="272" height="43" forecolor="#333333" uuid="706cc1e9-d912-49df-83be-96f29aa5a1bd"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[4.6. Additional details about the categories of personal data collected, the purposes of processing, and data protection measures are available in the Bank's Privacy Notice https://www.cbz.co.zw/privacy-notice/.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="705" width="272" height="12" forecolor="#1B3A5C" uuid="206dacde-9ebe-4bbf-a79c-77d391c2e08c">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[5.5.Account Disputes or Verification Requirements]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="612" width="270" height="43" forecolor="#333333" uuid="d7e3e2ec-972b-4944-b608-a4ea5f7c42ca"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[I may contact the Bank's Data Protection Officer or customer service channels for inquiries or to exercise my data rights. Details will be provided on request or through the Bank's official communication platforms.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="601" width="272" height="12" forecolor="#1B3A5C" uuid="ea45ea07-61d5-4213-a4d8-9e108fc3abcd">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[5.4. Internal Account Limitations]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="277" width="270" height="42" forecolor="#333333" uuid="b9bfa9c3-a1e0-4ff2-b06a-a257a941637d">
					<property name="local_mesure_unitheight" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[The Bank may contact me via SMS, email, mobile app, WhatsApp business channels, postal mail or phone. Communications sent to my last known contact details are deemed delivered when dispatched.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="204" width="270" height="12" forecolor="#1B3A5C" uuid="340bb53f-33b1-4743-94da-575f8d9545d4">
					<property name="local_mesure_unitheight" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[2.3. Overdrafts, Fees and Charges]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="99" width="270" height="12" forecolor="#1B3A5C" uuid="61e2e555-b3c6-4c7b-b92d-b668f883a5c4">
					<property name="local_mesure_unitheight" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[2.1. Account Establishment]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="206" width="272" height="40" forecolor="#333333" uuid="d2f4a50e-aeb3-4a7e-98f9-a03ff79cfeae"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[4.7. I acknowledge the Bank's obligations to comply with AML, CFT and sanctions laws and that it may delay or deny transactions where necessary.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="449" width="270" height="12" forecolor="#1B3A5C" uuid="1e794b7c-0858-4483-b2d6-c7af7bdf1955">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[3.4. Digital Platform Availability]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="688" width="270" height="72" forecolor="#333333" uuid="8417068c-272f-4182-93f3-921b14fa8139"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[4.2.The Client gives express consent for the Bank to collect, process, store, and share their personal data including identification details, contact information, financial information, and any data related to the account for purposes of account opening, detecting and preventing fraud and money laundering, regulatory compliance, and service provision.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="598" width="270" height="12" forecolor="#1B3A5C" uuid="9b0193fd-38bc-4145-8564-891f50bd93bc">
					<property name="local_mesure_unitheight" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[3.3. Contact for Data Protection Queries]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="673" width="270" height="12" forecolor="#1B3A5C" uuid="f1d9cf8a-8659-48a0-9bc8-8f90df6a9146">
					<property name="local_mesure_unitheight" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[4.1.Data Protection]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="463" width="270" height="27" forecolor="#333333" uuid="97056a72-f2e2-4691-8977-94a63bfeb15e"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[The Bank will take reasonable steps to maintain service availability but cannot guarantee it.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="272" width="272" height="12" forecolor="#1B3A5C" uuid="29129e9e-6079-4bb4-aae4-86324fa17e35">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[5.1. Compliance and Regulatory Restrictions]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="617" width="272" height="88" forecolor="#333333" uuid="8b4b0c69-97ee-4599-b036-66c9b4ed8a7b"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[5.4.1. The Bank may impose operational limits if:
a.the account has insufficient funds to complete a transaction;
b.the account is overdrawn or exceeds a set limit;
c.there are pending investigations related to the account; or
d.the customer fails to update mandatory KYC information.

5.4.2. The Bank may restrict withdrawals, transfers, or access to services until the limitation is resolved.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="378" width="270" height="12" forecolor="#1B3A5C" uuid="faf9e3dc-661f-45a9-b35a-9bc6549ed89e">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[3.2. Electronic Signatures]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="562" width="270" height="38" forecolor="#333333" uuid="4287559c-694b-4495-86d9-a1d50ae0193e"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[If a data breach occurs that may compromise my personal information, the Bank will notify me and applicable authorities as required by law, and take reasonable steps to mitigate any harm.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="109" width="272" height="51" forecolor="#333333" uuid="a5895471-b71f-4e0f-b792-8aa8ec95ef1b"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[4.5. The Bank may use automated decision making, including profiling, to assess aspects such as creditworthiness and financial behaviour. Should you be unhappy with the outcome, please feel free to contact us for further review or assistance.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="20" width="272" height="36" forecolor="#333333" uuid="b29e22bf-77a6-4ffa-95b4-5af8bb0b2ad6"/>
				<textElement>
					<font fontName="Arial" size="6.5"/>
				</textElement>
				<text><![CDATA[4.3. The Client further consents to the Bank sharing such information with authorised third parties, including regulators, auditors, service providers, and, where necessary, transferring this information to foreign countries by electronic or other means for processing in connection with the provision of financial services.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="499" width="272" height="12" forecolor="#1B3A5C" uuid="4040c39f-88e1-4d6e-9d6b-3056ac4d51f0">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[5.3.Transaction and Channel-Based Limits]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="720" width="272" height="70" forecolor="#333333" uuid="d5765f73-6c0f-40e8-b4b9-cf708cf2fc8a"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[5.5.1. Where the Bank identifies conflicting information or uncertainty regarding the ownership or control of the account, it may:
a.place temporary restrictions;
b.request updated identification or documents; or
c.delay or decline transactions until clarification is obtained.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="396" width="272" height="12" forecolor="#1B3A5C" uuid="920b1248-9199-4ea4-8625-7f88a3dedb3a">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[5.2. Limitations Due to Security or Fraud Concerns]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="86" width="270" height="12" forecolor="#1B3A5C" uuid="53bcf6e5-68c6-4adc-8d3c-819adc369f6b">
					<property name="local_mesure_unitheight" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[2. ACCOUNT OPENING & OPERATION]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="113" width="270" height="42" forecolor="#333333" uuid="4974ddc2-3647-40ff-8c57-842b45fb671f"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[a.The Bank may open an account for me once all Know Your Customer and due diligence checks are complete.
b.The Bank may decline my application without giving reasons.
c.The account becomes operational once the Bank allocates an account number and confirms activation.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="257" width="272" height="12" forecolor="#1B3A5C" uuid="00302e06-f1c6-4e9a-9dc9-735efb0b902f">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[A.Account Limitations]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="488" width="270" height="12" forecolor="#1B3A5C" uuid="28f550cf-08b6-426f-8ff2-1ee4eecd7698">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[3.1. Marketing Communication]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="159" width="270" height="12" forecolor="#1B3A5C" uuid="d49a7b77-5470-4e4a-b588-f5d2ade57dc8">
					<property name="local_mesure_unitheight" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[2.2. Digital Payment Instruments]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="217" width="270" height="43" forecolor="#333333" uuid="a42149e3-9f45-418d-8341-7e90d969207f"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[a.An overdraft or other credit facility may be granted at the Bank's sole discretion.
b.All fees, charges and interest will be debited according to the Bank's tariff guide.
c.I must repay any debit balance, authorised or unauthorised.

Where I receive any credit such as an overdraft, Schedule 1: Credit Facilities applies automatically.]]></text>
			</staticText>
			<line>
				<reportElement x="368" y="806" width="200" height="1" forecolor="#333333" uuid="6f8cf645-ad9b-424c-b4a9-9e6d83be4482"/>
				<graphicElement>
					<pen lineWidth="0.8"/>
				</graphicElement>
			</line>
			<staticText>
				<reportElement x="324" y="797" width="52" height="12" forecolor="#333333" uuid="8399c20d-ba70-4a6c-8d71-4e8d6ebf7175"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="10"/>
				</textElement>
				<text><![CDATA[Signature]]></text>
			</staticText>
		</band>
		<band height="811">
			<staticText>
				<reportElement x="283" y="20" width="272" height="22" forecolor="#333333" uuid="fceb84d1-02f1-403b-805f-dedd5ce44e41"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[The Bank may amend these Terms and will notify me. Continued use constitutes acceptance of the amended Terms and Conditions.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="245" width="272" height="11" forecolor="#1B3A5C" uuid="ea086103-06d9-46bb-8aaa-27e4776619bc"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[3. Representations & Warranties]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="602" width="268" height="44" forecolor="#333333" uuid="6c94956d-828b-4979-939b-6c3dd55c2cee"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[If the Bank incurs regulatory fines or financial prejudice due to my actions, omissions, misrepresentation or negligence, such amounts are recoverable under Schedule 1 where credit exists.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="370" width="272" height="11" forecolor="#1B3A5C" uuid="5698c614-a186-4110-8859-a080c724d2b9"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[4.2.Failure to Reimburse Penalties]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="383" width="272" height="22" forecolor="#333333" uuid="08d2b87a-e418-4f29-9527-2f7f1819ce21"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[If I fail to reimburse the Bank for any regulatory fine, penalty or financial prejudice within 14 days of written demand, an Event of Default occurs.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="199" width="268" height="11" forecolor="#1B3A5C" uuid="2187feae-a81c-4f18-a43b-b48be6bb41f9"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[5.7. Customer Liability During Dormancy]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="345" width="272" height="22" forecolor="#333333" uuid="50f45c69-35e2-403f-b116-02e545b30aa8"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[An event that materially affects my ability to meet obligations is an Event of Default.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="332" width="272" height="11" forecolor="#1B3A5C" uuid="87f31669-8612-489b-90a8-0b2cb3ae5d7f"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[4.1. Material Adverse Effect]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="676" width="268" height="33" forecolor="#333333" uuid="28c4381c-46e6-4aae-b71a-d493fe8a5462"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[7.2. Any dispute will be subject to the exclusive jurisdiction of Zimbabwean courts, without limiting the Bank's right to take action in another jurisdiction if necessary.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="435" width="272" height="44" forecolor="#333333" uuid="d37cedf1-15aa-4f17-8a6f-9bb778aae740"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[a.declare all Borrowed Money immediately due;
b.cancel the facility;
c.apply set-off;
d.enforce legal remedies.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="94" width="268" height="11" forecolor="#1B3A5C" uuid="c8cc248b-60b9-4657-a49a-0c236acba5d7"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[5.6. Effects of Dormancy]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="529" width="268" height="22" forecolor="#333333" uuid="0d0d17e2-3cbe-4280-a2c2-2a2879c79c99"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[6.2. The Bank is not liable for indirect loss unless caused by its negligence or fraud.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="304" width="268" height="11" forecolor="#1B3A5C" uuid="a39dc8f6-a933-4092-8558-23aa8b2f3ab6"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[5.8. Reactivation of a Dormant Account]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="317" width="268" height="88" forecolor="#333333" uuid="888b7986-b961-44fe-8aba-850ad122f5db"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[5.8.1. To reactivate a dormant account, the customer must:
a.provide updated KYC documents;
b.confirm identity in person or through approved digital verification;
c.sign any required reactivation forms or mandates; and
d.comply with any enhanced due diligence requirements depending on the risk assessment.

5.8.2. The Bank may decline reactivation if the customer fails to meet regulatory requirements.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="101" width="272" height="66" forecolor="#333333" uuid="100cf57f-586c-4548-96b6-168d8f16e9f1"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[a.all credit advanced by the Bank,
b.all interest, charges, and fees,
c.any regulatory penalties, fines, levies, or financial prejudice incurred by the Bank due to my negligence, misrepresentation, breach of law, or any act attributable to me (including RBZ penalties).]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="47" width="272" height="11" forecolor="#1B3A5C" uuid="4a3a8dbc-3021-477f-a8b6-9bc25f9cd89a"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[SCHEDULE 1]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="184" width="272" height="11" forecolor="#333333" uuid="46dfd78b-4d3a-4dd2-9b8a-cc3d8a86f8f3"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[I must pay, upon demand:]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="650" width="268" height="11" forecolor="#1B3A5C" uuid="d31ada6e-aa02-45c1-aacc-a9fe280b4352"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[7. GOVERNING LAW & DISPUTE RESOLUTION]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="60" width="272" height="11" forecolor="#1B3A5C" uuid="45a1bfd4-fea2-4f2d-ab4f-ac04f9543ac3"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[CREDIT FACILITIES (INDIVIDUAL ACCOUNT)]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="75" width="272" height="11" forecolor="#1B3A5C" uuid="99957604-332a-4f74-a2f3-b3471b313f47"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[1.Borrowed Money]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="492" width="268" height="11" forecolor="#1B3A5C" uuid="d5ea2c09-b81d-41da-9225-7f0738e9d991"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[6. LIABILITY, RESPONSIBILITIES & INDEMNITY]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="711" width="268" height="22" forecolor="#333333" uuid="21bed46c-fe33-4ad9-9b15-e98004e5e7a6"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[7.3. I may escalate unresolved complaints to the Reserve Bank of Zimbabwe or the relevant regulatory authority.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="319" width="272" height="11" forecolor="#1B3A5C" uuid="c85fa560-2bdd-4035-92cb-fd907885e64b"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[4.Events of Default]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="258" width="272" height="11" forecolor="#333333" uuid="66273567-e6d4-413c-85da-e28ec8c75443"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[I warrant that:]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="107" width="268" height="88" forecolor="#333333" uuid="b966c1dc-70bb-4871-bad6-e79a8389591c"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[5.6.1. Once the account becomes dormant:
a.withdrawals and transfers may be disabled;
b. debit cards may be deactivated;
c. mobile and internet banking access may be restricted;
d. the Bank may stop issuing statements or alerts; or
e. identity re-verification may be required to resume activity.
5.6.2. The Bank may also impose additional security checks to protect dormant funds from fraud.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="663" width="268" height="11" forecolor="#333333" uuid="7008e114-5cd9-498b-a90a-ed8d915094f9"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[7.1. These Terms and Conditions are governed by the laws of Zimbabwe.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="271" width="272" height="44" forecolor="#333333" uuid="574482e9-2980-47e9-b154-dbc3457b188c"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[a.all information I provide is correct;
b.I accept full liability for any financial prejudice caused by my conduct;
c.the Bank may demand immediate repayment of such amounts as Borrowed Money.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="409" width="272" height="11" forecolor="#1B3A5C" uuid="a5fdcbcd-8150-42df-9183-415a75ee4d1a"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[5. Remedies]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="554" width="268" height="11" forecolor="#1B3A5C" uuid="ebde6876-ffc3-4bca-ab1e-8e8f82e0c164"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[6.3. I indemnify the Bank against losses caused by:]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="88" width="272" height="11" forecolor="#333333" uuid="dacbf930-4bbd-4902-b09e-327991d000f2"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA["Borrowed Money" includes:]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="46" width="268" height="44" forecolor="#333333" uuid="d19ab193-decc-4ac5-a975-f1c988dbbc29"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[An account may be classified as dormant if no customer initiated transactions occur within a period defined by the Bank's policies or applicable law.
System generated transactions such as charges, interest, or automated entries do not count as customer initiated activity.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="212" width="268" height="88" forecolor="#333333" uuid="1dcd94d4-2d45-4916-bb41-a3c3a5cf6016"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[5.7.1. Even while the account is dormant:
a.service charges and statutory fees may continue to accrue;
b.any debit balance remains payable by the customer; and/or
c.the customer remains responsible for ensuring the Bank has current contact details.
5.7.2.The Bank is not liable for losses arising from unauthorised activity occurring before the account was classified as dormant but discovered only after dormancy.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="33" width="268" height="11" forecolor="#1B3A5C" uuid="f73cab49-c960-4ab7-be20-28e2fd285700"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[B. Dormancy]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="409" width="268" height="11" forecolor="#1B3A5C" uuid="57e074ee-d180-41a8-9b97-1dbe7fe9adab"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[5.9. Transfer to Unclaimed Funds]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="171" width="272" height="11" forecolor="#1B3A5C" uuid="f78bae88-5c52-46de-b494-de7e7b899753"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[2. Costs]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="422" width="272" height="11" forecolor="#333333" uuid="ab95dd0d-e797-4d9a-8548-184d4e2ed4be"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[Upon default, the Bank may:]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="7" width="268" height="22" forecolor="#333333" uuid="80aa855f-bad6-43ef-8b56-10fceea72593"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[This includes discrepancies in signatures, identification documents, or account records.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="197" width="272" height="44" forecolor="#333333" uuid="bc53028b-ef4c-4d7c-85d3-f6ecf65d081c"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[a.legal and enforcement costs,
b.administrative expenses,
c.regulatory penalties imposed on the Bank due to my conduct.

All such costs are immediately due once incurred.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="422" width="268" height="66" forecolor="#333333" uuid="9d51f052-24cb-4272-b9e6-9abd3d0066f7"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[5.9.1. If an account remains dormant beyond the statutory or Bank defined threshold, the Bank may:
a.transfer the balance to its internal unclaimed funds register, or
b.remit the funds to a regulatory unclaimed assets authority, where required by law
5.9.2. The customer may claim such funds subject to completion of the applicable recovery process.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="505" width="268" height="22" forecolor="#333333" uuid="885b5ca6-7d1a-4824-aa46-989b2c6cfd9b"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[6.1. I am responsible for correct and lawful use of my account and for the accuracy of instructions.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="7" width="272" height="11" forecolor="#1B3A5C" uuid="44e1bd8b-0c29-4506-85d1-6b4777d6f0b3"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[8. AMENDMENTS]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="567" width="268" height="33" forecolor="#333333" uuid="d4505895-b767-481d-8ffd-7b69fd2ff4d3"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[6.3.1. disclosure of my credentials,
6.3.2. compromise of my devices,
6.3.3. fraud due to my negligence.]]></text>
			</staticText>
			<line>
				<reportElement x="368" y="806" width="200" height="1" forecolor="#333333" uuid="367cb61c-1895-4e7d-849f-75d1b8206be6"/>
