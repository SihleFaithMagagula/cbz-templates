		<band height="801">
			<staticText>
				<reportElement x="0" y="77" width="268" height="11" forecolor="#1B3A5C" uuid="6ea9e53f-9ee2-49f2-ac24-b747b4227eb6"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[2.NATURE OF THE JOINT ACCOUNT]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="431" width="272" height="22" forecolor="#333333" uuid="def405c4-d92b-4fd5-8172-7ee542d1330b"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.7.3.In such cases, the Bank may freeze the account until the dispute is resolved by court order or written joint agreement.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="92" width="268" height="11" forecolor="#1B3A5C" uuid="cc42769a-661f-40fb-a7e6-13e449f9b0c2"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[2.1. Joint Ownership]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="605" width="272" height="11" forecolor="#1B3A5C" uuid="08b501e2-3aaa-4b57-b8a8-16789f4e9ba7"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[5. DEPOSITS, WITHDRAWALS & OVERDRAFTS]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="644" width="272" height="11" forecolor="#333333" uuid="11b1badb-1719-488e-8133-0fc2ee405060"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[5.3. Schedule 1 for Joint Accounts applies where credit is granted.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="579" width="272" height="22" forecolor="#333333" uuid="d2672454-9393-4ac8-8639-0fa9c38b7708"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[Each joint holder granted digital access binds all holders when initiating transactions.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="607" width="268" height="11" forecolor="#1B3A5C" uuid="f2b4efbb-c407-4060-af8e-05362426d2ac"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[3.4.Changes to the Mandate]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="631" width="272" height="11" forecolor="#333333" uuid="2574f19c-873d-458a-9652-f49fa3a254a2"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[5.2. All holders are jointly and severally liable for repayment.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="402" width="268" height="11" forecolor="#1B3A5C" uuid="7c1f058d-9f59-4fcb-b878-93a26bfa00f4"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[3.2.Binding Effect of Instructions]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="321" width="272" height="22" forecolor="#333333" uuid="69cdffc4-007a-4a64-a767-341929db909e"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.6.3.Joint holders are jointly and severally liable for transactions conducted electronically by any authorised holder.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="159" width="268" height="11" forecolor="#1B3A5C" uuid="642bfb61-95da-4138-beaf-440fe9c65862"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[2.3. Joint and Several Liability]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="540" width="272" height="22" forecolor="#333333" uuid="6d41bd4b-1696-47de-970a-a597749cbe65"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.8.2.Suspension may continue until properly authorised instructions are provided.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="618" width="272" height="11" forecolor="#333333" uuid="39429f96-edb6-4da8-bb5e-7235539645e9"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[5.1. Any overdraft extended to the joint account binds all account holders.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="50" width="272" height="44" forecolor="#333333" uuid="837853c5-0c73-4240-a890-3b9d79cb08ca"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[a.adding or removing a joint holder;
b.modifying signing instructions;
c.changes to digital or mobile banking access; and
d.changes in addresses or contact details, if held jointly.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="566" width="272" height="11" forecolor="#1B3A5C" uuid="66bc9355-eb35-4dbf-b998-f9d54119b2df"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[4. DIGITAL & ELECTRONIC BANKING]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="457" width="272" height="11" forecolor="#1B3A5C" uuid="ef297ac9-9207-4c47-a79b-be4f90ca4715"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[3.8. Suspension of the Mandate]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="262" width="272" height="33" forecolor="#333333" uuid="ff85c884-0242-474c-9b66-10bf6da8f434"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.6.1.Where digital, online, or mobile banking access is granted to any joint account holder, all actions performed by that holder through such channels are binding on all holders to the extent permitted by the mandate.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="581" width="268" height="22" forecolor="#333333" uuid="4089d20c-d610-4138-b01e-66d5fe776fde"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.3.2.The Bank shall not be liable for delays, losses, or inconvenience caused by such suspension or refusal while the matter is being resolved.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="296" width="268" height="33" forecolor="#333333" uuid="9e8127d8-f044-44fe-825e-227d45fbea1f"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.1.1.The joint account shall be operated strictly in accordance with the signing mandate selected by the account holders at the time of opening the account.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="483" width="272" height="55" forecolor="#333333" uuid="a08f69c9-41be-4fb6-b6c1-b65c643dd9a0"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[a.it suspects fraud or unlawful activity;
b.it receives contradictory instructions from joint holders;
c.it becomes aware of the death, incapacity, or bankruptcy of a joint holder; and
d.the account is subject to regulatory investigation.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="463" width="268" height="44" forecolor="#333333" uuid="9bccc96f-4fac-4604-8c3f-b212da1fe7ec"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.2.3. All joint holders are jointly and severally liable for:
a.withdrawals, transfers, or payments made by any permitted holder,
b.overdrafts created by actions of any one holder,
c.losses resulting from instructions properly authenticated under the mandate.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="360" width="272" height="44" forecolor="#333333" uuid="90c4a18c-60b6-45bb-8b92-423de9471a83"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.7.1.All joint account holders accept liability, jointly and severally, for losses arising from:
a.misuse of the account by any permitted holder under the mandate;
b.compromised digital credentials where negligence is established;
c.instructions that comply with the verification process prescribed by the Bank.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="105" width="268" height="11" forecolor="#333333" uuid="3db3590b-f890-4ed2-8717-0ff9306955ad"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[Funds in the account are jointly owned unless otherwise agreed.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="249" width="272" height="11" forecolor="#1B3A5C" uuid="44755f32-6354-485a-ae0c-581a1f8d66e3"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[3.6. Digital and Electronic Instructions]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="470" width="272" height="11" forecolor="#333333" uuid="0ec32448-5cf9-4637-900d-f97c67411cb1"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.8.1.The Bank may suspend the mandate without prior notice if:]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="511" width="268" height="11" forecolor="#1B3A5C" uuid="896eeb2d-07e0-4665-a557-0639e0afc18e"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[3.3. Conflicting or Ambiguous Instructions]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="283" width="268" height="11" forecolor="#333333" uuid="feacc410-c88e-4ff1-be95-23c766e956f1"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.1.Joint Mandate and Authority to Operate the Account]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="133" width="268" height="22" forecolor="#333333" uuid="cec2f329-7b5d-4ead-b27e-18e4668b9dbe"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[Account operation depends on the signing mandate. Where joint signatures are required, unilateral action is not permitted.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="366" width="268" height="33" forecolor="#333333" uuid="689f2f7c-9606-4092-8b51-19f3f799d066"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.1.3. All joint account holders acknowledge and accept that the Bank will rely on the mandate in force at the relevant time when processing transactions, payments, withdrawals, or digital instructions.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="439" width="268" height="22" forecolor="#333333" uuid="2853c8c8-d89b-41a3-a0f6-83261258077f"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.2.2.The Bank shall not be required to confirm whether such instruction benefits all holders equally.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="212" width="272" height="33" forecolor="#333333" uuid="490dfa56-dc28-46cc-83d4-31cd81461d92"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[a.the account is subject to legal restrictions;
b.there is an unresolved dispute between holders; or
c.liabilities remain outstanding.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="174" width="272" height="22" forecolor="#333333" uuid="9d31a577-c743-4599-a0c6-0d3b0386bc89"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.5.2.Upon closure, any credit balance will be paid in accordance with the agreed mandate or applicable law.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="97" width="272" height="22" forecolor="#333333" uuid="8993f8c8-2309-423f-9b01-fe4776a6eee0"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.4.3.The Bank may refuse to implement any requested change unless all holders provide updated identification and supporting documents.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="50" width="268" height="22" forecolor="#333333" uuid="4cd481db-4675-49c7-8991-823dd7a64ce4"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[These Terms govern the operation of a joint account opened with the Bank by the joint account holders ("we", "us", "our").]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="331" width="268" height="33" forecolor="#333333" uuid="04ec8f76-2268-4f76-b744-73a37d24e317"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.1.2.Depending on the chosen mandate, the Bank may:
a.act on the instructions of any one joint holder; or
b.require the signatures or authorisation of both/all joint holders.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="199" width="272" height="11" forecolor="#333333" uuid="63776061-b41c-4a90-83f1-2ef1a5076c6b"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.5.3.The Bank may refuse closure if:]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="123" width="272" height="11" forecolor="#1B3A5C" uuid="3c40850d-cf21-47fe-933e-e3f3fe984551"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[3.5. Account Closure]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="415" width="268" height="22" forecolor="#333333" uuid="cdb2c6ae-1468-4c76-91b6-24f85cab9e6b"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.2.1.Any instruction given by a joint account holder where permitted by the mandate shall be deemed to have been authorised by all joint account holders.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="172" width="268" height="55" forecolor="#333333" uuid="a8bbf10a-75c8-4f97-b00d-cad29ec6daa3"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[All joint account holders are jointly and severally liable for:
a.Overdrafts;
b.service charges;
c.fees; and
d.debts or liabilities incurred on the account.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="37" width="272" height="11" forecolor="#333333" uuid="050f81e7-655c-4643-a2ed-1a9255fc574a"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.4.2.Changes include (but are not limited to):]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="149" width="272" height="22" forecolor="#333333" uuid="bb14e238-5235-4b6b-9a97-0aaae1be7bec"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[a.all joint holders sign the closure request, or
b.the mandate expressly allows any one holder to close the account.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="297" width="272" height="22" forecolor="#333333" uuid="8299a721-1d8b-442f-ab94-5450d5c02584"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.6.2.The Bank shall rely on authentication methods such as passwords, PINs, biometrics and OTPs as proof of authority.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="120" width="268" height="11" forecolor="#1B3A5C" uuid="d4f0a7ba-7c54-4199-8693-c51fd849705d"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[2.2. Authority to Operate]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="17" width="555" height="13" forecolor="#1B3A5C" uuid="c601ad3b-b1c2-479d-82f3-6852344cc25e"/>
				<textElement>
					<font fontName="Arial" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[TERMS AND CONDITIONS]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="407" width="272" height="22" forecolor="#333333" uuid="2f08d975-b215-461c-b128-60fe1c3dff44"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.7.2.The Bank is not liable for disputes between joint account holders regarding ownership or use of funds.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="244" width="268" height="22" forecolor="#333333" uuid="c79e9bff-8922-4dc6-8fea-4da5b0bfd67f"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[The Bank may suspend operations pending legal documentation; surviving or remaining holders remain liable for obligations incurred.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="136" width="272" height="11" forecolor="#333333" uuid="03808fae-ff35-4b56-b4c9-f90af720b4e8"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.5.1.The Bank may act on a request to close the joint account if:]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="347" width="272" height="11" forecolor="#1B3A5C" uuid="6f01c4d6-fb85-4056-b08b-7dd7239efdb3"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[3.7.Liability for Misuse or Unauthorised Instructions]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="620" width="268" height="33" forecolor="#333333" uuid="a9c37e5d-ffef-48d6-8155-f22daec204e5"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.4.1.Any change to the signing mandate, account operation structure, or digital access permissions must be authorised jointly by both account holders, regardless of the existing mandate.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="37" width="268" height="11" forecolor="#1B3A5C" uuid="e2c43142-047b-4eb7-b0b3-b0d07e1bc7c6"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[1.INTRODUCTION]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="270" width="268" height="11" forecolor="#1B3A5C" uuid="08bc0f38-a624-4b77-a69f-8988bdd52fa8"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[3.MANDATE, INSTRUCTIONS & ACCOUNT CHANGES]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="524" width="268" height="55" forecolor="#333333" uuid="d3ad0bf7-6676-4650-ad2d-349c1d649c5d"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[3.3.1. If the Bank receives conflicting instructions from joint account holders, the Bank may:
a.suspend or freeze the account;
b.decline the conflicting instructions;
c.continue to act on the existing mandate until clarification is received; or
d.request a written joint agreement from all holders.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="231" width="268" height="11" forecolor="#1B3A5C" uuid="7b3b3ca6-7389-4a54-9657-056fa2f5aae5"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[2.4. Death, Incapacity or Insolvency]]></text>
			</staticText>
			<line>
				<reportElement x="368" y="793" width="200" height="1" forecolor="#333333" uuid="3ce9e599-68c7-4bf3-8755-f7333c594053">
					<property name="local_mesure_unitheight" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<graphicElement>
					<pen lineWidth="0.8"/>
				</graphicElement>
			</line>
			<staticText>
				<reportElement x="325" y="779" width="52" height="21" forecolor="#333333" uuid="ffcf1b0d-378b-4763-89de-10aa1cbcbdd9"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="10"/>
				</textElement>
				<text><![CDATA[Signature]]></text>
			</staticText>
		</band>
		<band height="801">
			<line>
				<reportElement x="368" y="798" width="200" height="1" forecolor="#333333" uuid="2c21c81f-25e6-486b-8329-6cb74949e02a">
					<property name="local_mesure_unitheight" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<graphicElement>
					<pen lineWidth="0.8"/>
				</graphicElement>
			</line>
			<staticText>
				<reportElement x="324" y="789" width="52" height="12" forecolor="#333333" uuid="7606ca3d-ca5b-4ec5-b708-de09a466e0cc"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="10"/>
				</textElement>
				<text><![CDATA[Signature]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="191" width="272" height="44" forecolor="#333333" uuid="6a4c9217-6a2a-4731-a3d6-a4cd4f607c3b"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[a.declare Borrowed Money immediately due,
b.cancel or reduce the facility,
c.set off against any account held by any joint holder,
d.enforce legal remedies.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="421" width="268" height="55" forecolor="#333333" uuid="fbc480ee-7d84-4045-b657-625f835525f8"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[10.4.The Bank may use automated decision making, including profiling, to assess aspects such as creditworthiness and financial behaviour. Should you be unhappy with the outcome, please feel free to contact us for further review or assistance.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="364" width="268" height="55" forecolor="#333333" uuid="f80714e8-bdfa-4bfb-b8cf-a6c0f3d593e5"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[10.3. The Client retains the right to access, correct, restrict processing, delete their data, withdraw consent, and object to marketing. These rights may be exercised by contacting the Bank's Data Protection Officer at privacy@cbz.co.zw.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="100" width="272" height="22" forecolor="#333333" uuid="708f813e-97ff-4f2d-b46f-d7fee3932b7b"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[Events that materially affect the joint holders' ability to meet obligations constitute default.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="141" width="268" height="11" forecolor="#333333" uuid="52b63bc3-e42f-446b-b658-7928e1db1a60"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[9.1. These Terms and Conditions are governed by the laws of Zimbabwe.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="525" width="268" height="11" forecolor="#1B3A5C" uuid="38c111b9-a9ab-4c83-b2dc-4c3fae6d0e39"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[SCHEDULE 1]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="189" width="268" height="22" forecolor="#333333" uuid="782224b5-0597-4b07-b4fe-eff972e0ee86"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[9.3. I may escalate unresolved complaints to the Reserve Bank of Zimbabwe or the relevant regulatory authority.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="74" width="272" height="11" forecolor="#1B3A5C" uuid="b3593fbd-1a58-4856-9248-21ef2052a6ed"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[4. Events of Default]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="24" width="272" height="11" forecolor="#333333" uuid="d8e82b40-ea2c-4690-9d2c-41f4f7627fe9"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[All joint holders warrant that:]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="89" width="268" height="11" forecolor="#1B3A5C" uuid="9e00495b-468a-41a0-af51-da247fab34c2"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[8. DISPUTES BETWEEN JOINT HOLDERS]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="579" width="268" height="55" forecolor="#333333" uuid="3881728a-73a0-40df-a670-0e51f0626ed0"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[a.all credit advanced to the joint account,
b.all interest and charges,
c.any regulatory fines, penalties or financial prejudice incurred by the Bank due to the conduct of any one joint account holder.
All joint holders are jointly and severally liable.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="139" width="272" height="22" forecolor="#333333" uuid="bad63b9b-e0e7-4f84-a523-51dd59bcf43e"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[Default occurs where joint holders fail to reimburse the Bank for a regulatory penalty or financial prejudice within 14 days of written demand.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="126" width="272" height="11" forecolor="#1B3A5C" uuid="d4a9d145-f42a-4b56-b58f-fc22b95259c3"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[4.2. Failure to Reimburse Penalties]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="50" width="268" height="11" forecolor="#1B3A5C" uuid="a97847bd-5833-4603-98a8-fc755153f519"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[7. FRAUD, MISUSE & INDEMNITY]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="165" width="272" height="11" forecolor="#1B3A5C" uuid="e6be4f05-81d0-4644-a5e2-05df4240cfaa"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[5. Remedies]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="11" width="268" height="11" forecolor="#1B3A5C" uuid="95c959b6-dc51-468f-b47c-c705731d3e0e"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[6. ACCOUNT INFORMATION & CONFIDENTIALITY]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="128" width="268" height="11" forecolor="#1B3A5C" uuid="0c745753-fd79-4720-b530-69aee8cfe548"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[9. GOVERNING LAW & AMENDMENTS]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="638" width="268" height="11" forecolor="#1B3A5C" uuid="3302d063-a5dc-4fd5-b2ba-9a3247866cc5"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[2. Costs]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="228" width="268" height="66" forecolor="#333333" uuid="5680df88-48e0-4177-91f7-61c820e5df85"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[10.1. The Client gives express consent for the Bank to collect, process, store, and share their personal data including identification details, contact information, financial information, and any data related to the account for purposes of account opening, detecting and preventing fraud and money laundering, regulatory compliance, and service provision.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="215" width="268" height="11" forecolor="#1B3A5C" uuid="32acdc00-3e2c-4d62-8650-75d13e2a0ecd"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[10. Data Protection]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="664" width="268" height="33" forecolor="#333333" uuid="c1a3fac2-4cd0-4b9c-81e4-98a53ceb7d3b"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[a.          legal and enforcement costs,
b.          administrative charges,
c.          regulatory penalties incurred due to any holder's conduct.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="651" width="268" height="11" forecolor="#333333" uuid="a685dd24-ffb6-4496-bfd3-fb6dda0a5ee2"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[All joint holders must repay, upon demand:]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="538" width="268" height="11" forecolor="#1B3A5C" uuid="04ea91f4-811a-43f6-9576-1ae9618dd47f"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[CREDIT FACILITIES (JOINT ACCOUNT)]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="478" width="268" height="33" forecolor="#333333" uuid="d237674a-4497-4c42-9b6a-170e2c274253"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[10.5. Additional details about the categories of personal data collected, the purposes of processing, and data protection measures are available in the Bank's Privacy Notice https://www.cbz.co.zw/privacy-notice/.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="24" width="268" height="22" forecolor="#333333" uuid="73077184-5926-4c2e-add1-60835bd04abc"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[Information may be disclosed to any joint holder; no holder may claim confidentiality against another.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="87" width="272" height="11" forecolor="#1B3A5C" uuid="06c821f9-dc2d-4c2d-829b-0d65a8c1cf08"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[4.1. Material Adverse Effect]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="178" width="272" height="11" forecolor="#333333" uuid="43358fad-22c8-41d8-a2ea-e1dcc0c1f1ac"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[Upon default, the Bank may:]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="102" width="268" height="22" forecolor="#333333" uuid="849856d2-7481-4d30-a883-bf16dc283566"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[The Bank may freeze the account until disputes are resolved by agreement or court order.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="296" width="268" height="66" forecolor="#333333" uuid="6cdfacc6-2f42-49c7-b519-924ebd33910c"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[10.2. The Client further consents to the Bank sharing such information with authorised third parties, including regulators, auditors, service providers, and, where necessary, transferring this information to foreign countries by electronic or other means for processing in connection with the provision of financial services.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="566" width="268" height="11" forecolor="#333333" uuid="8f1682e3-9ea1-4a2b-af2b-2e0e38865735"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA["Borrowed Money" includes:]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="63" width="268" height="22" forecolor="#333333" uuid="0f1f9631-0c8f-402d-94c5-cbde06814135"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[All joint holders indemnify the Bank for losses caused by fraud, misuse, credential compromise or negligence by any holder.]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="11" width="272" height="11" forecolor="#1B3A5C" uuid="fc6f469f-f722-464c-bb63-29e7d46d4ffe"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[3. Representations & Warranties]]></text>
			</staticText>
			<staticText>
				<reportElement x="283" y="37" width="272" height="33" forecolor="#333333" uuid="a03107c9-1c4e-4f6c-9d38-8de24e0c35a0"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[a.all provided information is true;
b.they accept liability for any financial prejudice caused by any of them;
c.the Bank may demand immediate repayment of such amounts.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="154" width="268" height="33" forecolor="#333333" uuid="d0d754e1-dab9-4a40-88db-6ea871c44205"/>
				<textElement>
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[9.2. Any dispute will be subject to the exclusive jurisdiction of Zimbabwean courts, without limiting the Bank's right to take action in another jurisdiction if necessary.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="553" width="268" height="11" forecolor="#1B3A5C" uuid="33e52f03-ceff-473a-931e-7862ec34a33f"/>
				<textElement>
					<font fontName="Arial" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[1. Borrowed Money (Joint)]]></text>
			</staticText>
